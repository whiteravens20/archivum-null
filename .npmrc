# ── Supply-chain hardening ──
# Block post-install scripts from dependencies — prevents malicious packages
# from executing arbitrary code during `npm install` / `npm ci`.
# If a trusted package genuinely needs scripts (e.g. esbuild, sharp),
# allow it explicitly:  npm rebuild <package>
ignore-scripts=true

# Quarantine window — refuse to resolve any package version published less
# than 7 days ago. Most supply-chain attacks (typosquatting, account takeover)
# are detected by the community within hours; a 7-day buffer eliminates the
# majority of the risk.
#
# This is the backstop, not the primary control. It fires at *resolution*
# (`npm install`, `npm update`) — in practice a human adding or bumping a
# package by hand. It does not apply to `npm ci`, which installs exactly what
# the lockfile already pins. Dependabot is quarantined upstream instead, by
# `cooldown: default-days: 7` in .github/dependabot.yml.
min-release-age=7

# Registry signatures are verified by `npm audit signatures` in
# .github/workflows/security.yml. Do not try to set that here: `audit-signatures`
# is a flag on the `npm audit` command, not an npmrc config key. npm parses it,
# warns "Unknown project config", and it has no effect on install.

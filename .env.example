# ── Archivum Null ── Zero Trust File Relay ── .env.example ──
#
# Copy this file to .env and fill in your values.
#
# ⚠  IMPORTANT: Docker Compose env_file does NOT support inline comments!
#    Do NOT put comments after values on the same line:
#      WRONG:  MY_VAR=value   # this is treated as part of the value
#      RIGHT:  # description
#              MY_VAR=value
#
# [PROD] = review before going to production
# [DEV]  = safe default for local development, change for production


# ── Container image ──────────────────────────────────────────────────────────

# [PROD] Tag of the ghcr.io image to pull and run.
#        'main' always points to the most recent stable production release.
#        Set to a specific version (e.g. 1.2.3) to pin deployments and control upgrades.
#        Do NOT use 'edge' or 'dev' in production — those are CI snapshot builds.
IMAGE_TAG=main


# ── File size ─────────────────────────────────────────────────────────────────

# bytes — max upload (backend + frontend enforce)
MAX_FILE_SIZE=104857600

# Chunked uploads — split large encrypted blobs into smaller HTTP requests so
# each one stays below Cloudflare's 100 MB per-request limit (Free/Pro plans).
# The frontend automatically chooses chunked upload when the blob exceeds this size.
# Smaller chunks (10 MB default) work better for homelab/Tailscale/VPS setups
# with limited bandwidth and flaky connections.

# bytes — 10 MB per HTTP chunk
CHUNK_SIZE=10485760
# seconds — incomplete chunked upload lifetime (60 min)
UPLOAD_SESSION_TTL=3600

# ⚠  Constraint: CHUNK_SIZE ≤ MAX_FILE_SIZE (validated at startup)
#
# CRYPTO_CHUNK_SIZE (per-chunk AES-GCM plaintext size, default 5 MB) is auto-derived
# as min(5 MB, CHUNK_SIZE). Override via env only if you know what you're doing.
# Must satisfy: CRYPTO_CHUNK_SIZE ≤ CHUNK_SIZE.


# ── Cloudflare Turnstile (CAPTCHA) ────────────────────────────────────────────
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave as-is to disable Turnstile (backend detects the dummy key and skips verification).

# [PROD] public site key (backend + embedded in frontend bundle)
TURNSTILE_SITE_KEY=0x0000000000000000000000
# [PROD] server-side secret — never expose this
TURNSTILE_SECRET=0x0000000000000000000000
# [PROD] expected hostname in Turnstile response (e.g. example.com); leave empty to skip check
TURNSTILE_HOSTNAME=


# ── Rate limiting (in-memory, per IP) ─────────────────────────────────────────
# Tier-specific limits (UPLOAD, DOWNLOAD, ADMIN) are checked ON TOP of the
# general API limit.  Setting any of them higher than RATE_LIMIT_API_MAX is
# pointless — the API limit will fire first.  The backend warns at startup.

# seconds per window
RATE_LIMIT_WINDOW=60
# max ALL /api/ requests per window per IP (global cap)
RATE_LIMIT_API_MAX=120
# max new-upload requests (POST vault / upload init)
RATE_LIMIT_MAX=10
# max download requests per window per IP
RATE_LIMIT_DOWNLOAD_MAX=30


# ── Vault defaults ────────────────────────────────────────────────────────────

# Valid TTL values (seconds) shown in the UI dropdown:
#   300 (5 min) | 1800 (30 min) | 3600 (1 h) | 21600 (6 h)
#   86400 (24 h) | 259200 (3 d) | 604800 (7 d)
# If the value you set does not match one of the above, the frontend snaps to the
# nearest available option and logs a warning in the browser console (dev mode only).
# The backend clamps the received value to the range [60, MAX_TTL] regardless.

# seconds — pre-selected TTL in the UI (24 h); must be one of the valid values above
DEFAULT_TTL=86400

# seconds — hard upper limit the backend enforces (7 days)
# Must be > 0 and >= DEFAULT_TTL
MAX_TTL=604800

# Valid max-download values shown in the UI dropdown:
#   1 | 3 | 5 | 10 | 25 | 50 | 100
# If the value you set does not match one of the above, the frontend snaps to the
# nearest available option and logs a warning in the browser console (dev mode only).

# pre-selected download limit in the UI; must be one of the valid values above
DEFAULT_MAX_DOWNLOADS=10


# ── Admin panel ───────────────────────────────────────────────────────────────

ADMIN_USER=admin
# [PROD] required — panel is disabled if empty or default
ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY


# ── Storage ───────────────────────────────────────────────────────────────────

# path inside container; map via Docker volume
STORAGE_PATH=/data/vaults

# [PROD] Global storage quota — total bytes all active vaults may occupy on disk.
#        When the quota is reached, new uploads are rejected with HTTP 507 and the
#        user is asked to try again later or contact the administrator.
#        Set to 0 to disable the quota (unlimited storage).
#        Example: 10 GB → 10737418240
MAX_TOTAL_STORAGE=0


# ── Network ───────────────────────────────────────────────────────────────────

# Docker deployments — controls which HOST interface Docker publishes the port on.
# [PROD] Set to your WireGuard / private tunnel interface IP (e.g. 10.8.0.1).
#        The app always binds to 0.0.0.0 inside the container (Docker network
#        namespace); this restricts which host interface the mapped port appears on.
# [DEV]  Not used in docker-compose.dev.yml — dev binds to 0.0.0.0 for LAN access.

# [PROD] e.g. 10.8.0.1 or your wg0 peer address
HOST_BIND_ADDRESS=<tunnel-ip>

# Non-Docker / bare-metal — the address Fastify binds to directly.
# For Docker, docker-compose.yml overrides this to 0.0.0.0 regardless.
BIND_ADDRESS=0.0.0.0

PORT=3000

# How many reverse-proxy hops to trust when reading X-Forwarded-For.
# 1 = trust only the nearest proxy (default, correct for a single nginx/Caddy in front).
# Do NOT set to 0 or a very high value in production.
TRUST_PROXY=1


# ── Runtime ───────────────────────────────────────────────────────────────────

# [DEV] set to development for verbose logs and hot-reload
NODE_ENV=production

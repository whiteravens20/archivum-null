# ── Supply-chain hardening ──
# See root .npmrc for rationale.
ignore-scripts=true
min-release-age=7

# eslint-plugin-react-hooks@7.0.1 declares peer deps only up to eslint ^9,
# but works correctly with eslint v10 at runtime. This flag allows npm ci
# to resolve the tree without erroring on the stale peer dep metadata.
# Remove when eslint-plugin-react-hooks releases v10 peer dep support.
legacy-peer-deps=true

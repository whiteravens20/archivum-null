# ── Development Dockerfile ──
# One image per service of docker-compose.dev.yml. Each installs its dependencies
# from the lockfile at build time and runs as the image's non-root user (uid 1000);
# the Compose file mounts the sources over the copies made here, read-only.
#
# Base image pinned by version and digest, the same one the production Dockerfile uses.
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS base

# Upgrade all Alpine packages to latest patched versions (catches zlib CVE-2026-22184 and any future OS-level CVEs)
RUN apk upgrade --no-cache

# ── Backend ──
FROM base AS backend

# Install backend dependencies
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json* backend/.npmrc* ./
RUN npm ci --ignore-scripts

# Copy backend source (will be overridden by volume mount in dev)
COPY backend/ ./

# Data dir owned by the non-root runtime user. A freshly-created named volume
# mounted at /data/vaults inherits this ownership, so uploads work without root.
RUN mkdir -p /data/vaults && chown -R node:node /data /app

# Security: run as the built-in non-root user (uid 1000)
USER node

ARG PORT=3000
EXPOSE ${PORT}

# Health check (busybox wget ships in the base image)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:${PORT:-3000}/api/health || exit 1

CMD ["npx", "tsx", "watch", "src/index.ts"]

# ── Frontend ──
FROM base AS frontend

# The dev server writes its cache and its self-signed certificate under
# node_modules/.vite, so the dependencies are installed by the user that runs it.
WORKDIR /app/frontend
RUN chown node:node /app/frontend
USER node
COPY --chown=node:node frontend/package.json frontend/package-lock.json* frontend/.npmrc* ./
RUN npm ci --ignore-scripts

# Copy frontend source (will be overridden by volume mounts in dev)
COPY --chown=node:node frontend/ ./

EXPOSE 5173

CMD ["npx", "vite", "--host", "0.0.0.0"]

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git fetch:*)",
      "Bash(git stash list)",
      "Bash(git blame:*)",
      "Bash(git remote -v)",

      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api repos/:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",

      "Bash(ls:*)",
      "Bash(find . -name:*)",
      "Bash(find . -path:*)",
      "Bash(find . -type:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",

      "Bash(cd backend && npm run lint)",
      "Bash(cd backend && npm run lint:fix)",
      "Bash(cd backend && npm run typecheck)",
      "Bash(cd backend && npm run build)",
      "Bash(cd backend && npm run test)",
      "Bash(cd backend && npm run test:coverage)",
      "Bash(cd backend && npm ci --ignore-scripts)",
      "Bash(cd backend && npm ci --ignore-scripts --dry-run)",
      "Bash(cd backend && npm audit:*)",
      "Bash(cd backend && npm outdated)",
      "Bash(cd backend && npm ls:*)",

      "Bash(cd frontend && npm run lint)",
      "Bash(cd frontend && npm run lint:fix)",
      "Bash(cd frontend && npm run typecheck)",
      "Bash(cd frontend && npm run build)",
      "Bash(cd frontend && npm run test)",
      "Bash(cd frontend && npm run test:coverage)",
      "Bash(cd frontend && npm ci --ignore-scripts)",
      "Bash(cd frontend && npm ci --ignore-scripts --dry-run)",
      "Bash(cd frontend && npm audit:*)",
      "Bash(cd frontend && npm outdated)",
      "Bash(cd frontend && npm ls:*)",

      "Bash(npm view:*)",
      "Bash(npm config get:*)",

      "Bash(docker build --no-cache -t archivum-null:local .)",
      "Bash(docker compose -f docker-compose.dev.yml config)",
      "Bash(docker compose config)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | sh)",
      "Bash(wget:* | bash)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore --staged --worktree:*)",
      "Bash(git commit:* --no-verify:*)",
      "Bash(git commit:* --no-gpg-sign:*)",
      "Bash(git rebase -i:*)",

      "Bash(npm publish:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm config set:*)",
      "Bash(npm cache clean:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bun install:*)",
      "Bash(npx:*)",

      "Bash(docker push:*)",
      "Bash(docker login:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",

      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(docker run:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Edit(./Dockerfile)",
      "Edit(./Dockerfile.dev)",
      "Edit(./.npmrc)",
      "Edit(./.trivyignore)",
      "Edit(./.github/workflows/**)",
      "Edit(./.github/dependabot.yml)",
      "Edit(./backend/package.json)",
      "Edit(./frontend/package.json)",
      "Edit(./backend/package-lock.json)",
      "Edit(./frontend/package-lock.json)",
      "Edit(./frontend/src/crypto/**)",
      "Edit(./backend/src/middleware/**)",
      "Edit(./backend/src/vault/**)",
      "Edit(./backend/src/storage/**)",
      "Edit(./SECURITY.md)"
    ]
  }
}
